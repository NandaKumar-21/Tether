<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D0F"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.24"
            android:text="CODE"
            android:textColor="#8A939C"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/wsFileLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:fontFamily="monospace"
            android:text=""
            android:textColor="#6B7680"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/wsLangPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_bg"
            android:backgroundTint="#4ADE80"
            android:letterSpacing="0.1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="C"
            android:textColor="#0B0D0F"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- honesty banner, always visible above the editor and the output -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1408"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="AI analysis only. Nothing here compiles or runs this code."
        android:textColor="#F5C451"
        android:textSize="12sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- FILE LIST -->
        <LinearLayout
            android:id="@+id/wsFileListPane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="10dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/wsFileListRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="14dp"
                android:paddingBottom="16dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/wsNewCBtn"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_bg"
                    android:letterSpacing="0.14"
                    android:stateListAnimator="@null"
                    android:text="NEW .C"
                    android:textColor="#C7D0D9"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/wsNewPyBtn"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_bg"
                    android:letterSpacing="0.14"
                    android:stateListAnimator="@null"
                    android:text="NEW .PY"
                    android:textColor="#C7D0D9"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- EDITOR -->
        <LinearLayout
            android:id="@+id/wsEditorPane"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:scrollbars="none">

                <EditText
                    android:id="@+id/wsEditor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:fontFamily="monospace"
                    android:gravity="top"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:textColor="#C7D0D9"
                    android:textSize="14sp" />

            </ScrollView>

            <ScrollView
                android:id="@+id/wsOutputScroll"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:background="@drawable/panel_bg"
                android:layout_margin="12dp"
                android:padding="10dp"
                android:scrollbars="none"
                android:visibility="gone">

                <TextView
                    android:id="@+id/wsOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingMultiplier="1.3"
                    android:textColor="#F2F5F7"
                    android:textSize="15sp" />

            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/wsAskBtn"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_bg"
                    android:letterSpacing="0.06"
                    android:stateListAnimator="@null"
                    android:text="ASK AI"
                    android:textColor="#C7D0D9"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/wsExplainBtn"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_bg"
                    android:letterSpacing="0.06"
                    android:stateListAnimator="@null"
                    android:text="EXPLAIN"
                    android:textColor="#C7D0D9"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/wsBugBtn"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_bg"
                    android:letterSpacing="0.06"
                    android:stateListAnimator="@null"
                    android:text="FIND BUG"
                    android:textColor="#C7D0D9"
                    android:textSize="12sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/wsImproveBtn"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_bg"
                    android:letterSpacing="0.06"
                    android:stateListAnimator="@null"
                    android:text="IMPROVE"
                    android:textColor="#C7D0D9"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/wsBackBtn"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_bg"
                    android:letterSpacing="0.14"
                    android:stateListAnimator="@null"
                    android:text="FILES"
                    android:textColor="#C7D0D9"
                    android:textSize="14sp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/wsSaveBtn"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_primary"
                    android:letterSpacing="0.14"
                    android:stateListAnimator="@null"
                    android:text="SAVE"
                    android:textColor="#08110B"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
