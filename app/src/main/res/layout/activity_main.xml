<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D0F"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="10dp"
    android:paddingBottom="18dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.22"
            android:text="TETHER"
            android:textColor="#E6EAEE"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_bg"
            android:backgroundTint="#7A8590"
            android:letterSpacing="0.12"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="LOADING"
            android:textColor="#0B0D0F"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- STATUS BLOCK -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/MetricLabel"
                android:text="BACKEND" />

            <TextView
                android:id="@+id/backendValue"
                style="@style/MetricValue"
                android:text="—" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/MetricLabel"
                android:text="TOKENS/SEC" />

            <TextView
                android:id="@+id/tpsValue"
                style="@style/MetricValue"
                android:textColor="#4ADE80"
                android:text="0.0" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/MetricLabel"
                android:text="REQUESTS" />

            <TextView
                android:id="@+id/requestsValue"
                style="@style/MetricValue"
                android:textColor="#4ADE80"
                android:text="0" />
        </LinearLayout>

    </LinearLayout>

    <TextView
        style="@style/MetricLabel"
        android:layout_marginTop="16dp"
        android:text="MODEL" />

    <TextView
        android:id="@+id/modelValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="—"
        android:textColor="#C7D0D9"
        android:textSize="20sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="14dp"
        android:background="#1E252B" />

    <TextView
        style="@style/MetricLabel"
        android:text="LATEST ANSWER" />

    <!-- ANSWER AREA -->
    <ScrollView
        android:id="@+id/answerScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/answerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.4"
            android:paddingBottom="12dp"
            android:text="waiting for the first request"
            android:textColor="#C7D0D9"
            android:textSize="18sp" />

    </ScrollView>

    <!-- ACTIONS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <!-- AppCompatButton, not Button: the Material theme swaps <Button> for
             MaterialButton, which ignores android:background and forces its own tint. -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/scanBtn"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/btn_bg"
            android:letterSpacing="0.14"
            android:stateListAnimator="@null"
            android:text="SCAN"
            android:textColor="#E6EAEE"
            android:textSize="16sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/micBtn"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:background="@drawable/btn_bg"
            android:letterSpacing="0.14"
            android:stateListAnimator="@null"
            android:text="MIC"
            android:textColor="#E6EAEE"
            android:textSize="16sp" />

    </LinearLayout>

</LinearLayout>
