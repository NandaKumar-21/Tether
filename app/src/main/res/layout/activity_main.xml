<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D0F"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="20dp">

    <!-- 1. TETHER + status pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.24"
            android:text="TETHER"
            android:textColor="#8A939C"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/statusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_bg"
            android:backgroundTint="#7A8590"
            android:letterSpacing="0.14"
            android:paddingStart="11dp"
            android:paddingEnd="11dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="LOADING"
            android:textColor="#0B0D0F"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- 2. three numbers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/MetricLabel"
                android:text="BACKEND" />

            <TextView
                android:id="@+id/backendValue"
                style="@style/MetricValue"
                android:text="—" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/MetricLabel"
                android:text="TOK/SEC" />

            <TextView
                android:id="@+id/tpsValue"
                style="@style/MetricValue"
                android:textColor="#4ADE80"
                android:text="0.0" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/MetricLabel"
                android:text="REQUESTS" />

            <TextView
                android:id="@+id/requestsValue"
                style="@style/MetricValue"
                android:textColor="#4ADE80"
                android:text="0" />
        </LinearLayout>

    </LinearLayout>

    <!-- 3. the answer -->
    <ScrollView
        android:id="@+id/answerScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="56dp"
        android:clipToPadding="false"
        android:scrollbars="none">

        <TextView
            android:id="@+id/answerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.4"
            android:paddingBottom="16dp"
            android:text=""
            android:textColor="#F2F5F7"
            android:textSize="18sp" />

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/studioBtn"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1.2"
            android:background="@drawable/btn_bg"
            android:letterSpacing="0.16"
            android:stateListAnimator="@null"
            android:text="STUDIO"
            android:textColor="#4ADE80"
            android:textSize="15sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/scanBtn"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/btn_bg"
            android:letterSpacing="0.16"
            android:stateListAnimator="@null"
            android:text="SCAN"
            android:textColor="#C7D0D9"
            android:textSize="15sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/micBtn"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/btn_bg"
            android:letterSpacing="0.16"
            android:stateListAnimator="@null"
            android:text="MIC"
            android:textColor="#C7D0D9"
            android:textSize="15sp" />

    </LinearLayout>

</LinearLayout>
