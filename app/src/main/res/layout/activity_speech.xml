<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D0F"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="10dp"
    android:paddingBottom="18dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="18dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.22"
            android:text="VOICE"
            android:textColor="#E6EAEE"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/speechStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/pill_bg"
            android:backgroundTint="#7A8590"
            android:letterSpacing="0.12"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="IDLE"
            android:textColor="#0B0D0F"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        style="@style/MetricLabel"
        android:text="YOU SAID" />

    <TextView
        android:id="@+id/transcript"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/panel_bg"
        android:lineSpacingMultiplier="1.3"
        android:minHeight="64dp"
        android:padding="14dp"
        android:text="tap the button and speak"
        android:textColor="#4ADE80"
        android:textSize="22sp" />

    <TextView
        style="@style/MetricLabel"
        android:layout_marginTop="20dp"
        android:text="ANSWER" />

    <ScrollView
        android:id="@+id/answerScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:clipToPadding="false"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/answer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.4"
            android:paddingBottom="12dp"
            android:text="—"
            android:textColor="#C7D0D9"
            android:textSize="18sp" />

    </ScrollView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/micBtn"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/btn_primary"
        android:letterSpacing="0.14"
        android:stateListAnimator="@null"
        android:text="TAP TO SPEAK"
        android:textColor="#08110B"
        android:textSize="17sp"
        android:textStyle="bold" />

</LinearLayout>
