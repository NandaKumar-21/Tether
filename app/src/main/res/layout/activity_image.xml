<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D0F"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="12dp"
    android:paddingBottom="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.24"
        android:text="IMAGE"
        android:textColor="#8A939C"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/imgPipeline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:paddingBottom="16dp"
        android:fontFamily="monospace"
        android:text="IMAGE -&gt; OCR -&gt; LOCAL GEMMA -&gt; RESPONSE"
        android:textColor="#6B7680"
        android:textSize="13sp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/imgPickBtn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/btn_primary"
        android:letterSpacing="0.14"
        android:stateListAnimator="@null"
        android:text="PICK IMAGE FROM GALLERY"
        android:textColor="#08110B"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="18dp"
        android:paddingBottom="6dp"
        android:text="EXTRACTED TEXT"
        android:textColor="#6B7680"
        android:textSize="12sp"
        android:letterSpacing="0.16" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/panel_bg"
        android:padding="12dp">

        <TextView
            android:id="@+id/imgOcrText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingMultiplier="1.3"
            android:text="pick an image to begin"
            android:textColor="#4ADE80"
            android:textSize="15sp" />

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="14dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/imgAnalyseBtn"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/btn_bg"
            android:letterSpacing="0.08"
            android:stateListAnimator="@null"
            android:text="ANALYSE"
            android:textColor="#C7D0D9"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/imgExplainBtn"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/btn_bg"
            android:letterSpacing="0.08"
            android:stateListAnimator="@null"
            android:text="EXPLAIN"
            android:textColor="#C7D0D9"
            android:textSize="13sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/imgFixBtn"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/btn_bg"
            android:letterSpacing="0.08"
            android:stateListAnimator="@null"
            android:text="FIX"
            android:textColor="#C7D0D9"
            android:textSize="13sp" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:paddingBottom="6dp"
        android:text="RESPONSE"
        android:textColor="#6B7680"
        android:textSize="12sp"
        android:letterSpacing="0.16" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/panel_bg"
        android:padding="12dp">

        <TextView
            android:id="@+id/imgResponse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.4"
            android:text="—"
            android:textColor="#F2F5F7"
            android:textSize="17sp" />

    </ScrollView>

</LinearLayout>
