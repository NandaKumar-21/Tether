<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="MetricLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#6B7680</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!-- tnum keeps digit widths equal so live numbers do not jitter as they update -->
    <style name="MetricValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textColor">#F2F5F7</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:includeFontPadding">false</item>
    </style>

</resources>
